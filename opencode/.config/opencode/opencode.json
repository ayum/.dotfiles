{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/kimi-k3.1-pro",
  "small_model": "opencode-go/glm-5.3-flash",
  "default_agent": "lead",
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow"
  },
  "agent": {
    "build": {
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": "allow"
      }
    }
  },
  "lsp": true,
  "plugins": [
    "@slkiser/opencode-quota"
  ],
  "provider": {
    "openai": {},
    "zai": {},
    "kimi-code-plan-global": {},
    "opencode-go": {},
    "opencode": {}
  },
  "plugin": [
    "oh-my-opencode-slim"
  ]
}
