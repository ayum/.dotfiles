# Dependencies
node_modules/

# Machine-local OpenCode service state
.config/opencode/service.json

# OAK transaction backups
.config/opencode/.oak/rollback/

# Credentials and local environment
.config/opencode/auth.json
.config/opencode/.env
.config/opencode/.env.*
!.config/opencode/.env.example

# Local SQLite data
.config/opencode/*.db
.config/opencode/*.db-shm
.config/opencode/*.db-wal

# Logs
.config/opencode/log/
.config/opencode/logs/
.config/opencode/**/*.log

# Temporary files and caches
.config/opencode/.cache/
.config/opencode/cache/
.config/opencode/tmp/
.config/opencode/.tmp/

# OS and editor metadata
.DS_Store
*.swp
